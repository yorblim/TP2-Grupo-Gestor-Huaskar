# Conexión a la base de datos PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gestor_huaskar?schema=public"

# Clave secreta para firma de JSON Web Tokens (mínimo 8 caracteres)
JWT_SECRET="tu-secreto-jwt-aqui-super-seguro"

# Configuración del servidor
PORT=3000
NODE_ENV="development"

# Orígenes CORS permitidos adicionales (opcional, separados por coma)
# CORS_ORIGIN="http://localhost:5173,https://mi-dominio.com"

# Datos reales del negocio para documentos internos; no se inventan datos fiscales.
BUSINESS_NAME="HUSKAR Minimarket"
BUSINESS_ADDRESS="Cusco, Perú"
BUSINESS_RUC=""
BUSINESS_PHONE=""
